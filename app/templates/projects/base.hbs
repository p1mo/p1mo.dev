<div class="history-h1">My Projects</div>
<div class="project-container">
{{#each projects}}
    {{#each this}}
        {{#if this.main}}
            <div class="main">
                {{#if (eq this.logo null)}}
                    <span class="logo">
                        <app-icon name="globe"></app-icon>
                    </span>
                {{else}}
                    <span class="logo">{{{this.logo}}}</span>
                {{/if}}
                <span class="title">{{this.title}}</span>
                <span class="desc">{{this.desc}}</span>
                <span class="site"><a href="https://{{this.site}}" target="_blank">{{this.site}}</a><app-icon name="link"></app-icon></span>
            </div>
        {{else}}
            <div class="sub">
                {{#if (eq this.logo null)}}
                    <span class="logo">
                        <app-icon name="globe"></app-icon>
                    </span>
                {{else}}
                    <span class="logo">{{{this.logo}}}</span>
                {{/if}}
                <span class="title">{{this.title}}</span>
                <span class="desc">{{this.desc}}</span>
                <span class="site"><a href="https://{{this.site}}" target="_blank">{{this.site}}</a><app-icon name="link"></app-icon></span>
            </div>
        {{/if}}
    {{/each}}
{{/each}}
</div>