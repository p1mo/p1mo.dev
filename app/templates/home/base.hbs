<div class="home-container">

    <div class="heading">
        <div class="info">
            <h1 class="title">Martin Bus</h1>
            <h2 class="sub">Software Engineer</h2>
            <h3 class="desc">Webservices, Desktop, Mobile and more.</h3>
            <span class="socials">
                <a href="https://github.com/p1mo" target="_blank">
                    <app-icon name="gh-brand"></app-icon>
                    <span class="name">GitHub</span>
                </a>
                <a href="https://crates.io/users/p1mo" target="_blank">
                    <app-icon name="crate-brand"></app-icon>
                    <span class="name">crates.io</span>
                </a>
                <a href="https://buymeacoffee.com/p1mo" target="_blank">
                    <app-icon name="coffee-brand"></app-icon>
                    <span class="name">BuyMeACoffee</span>
                </a>
                <a href="https://apex.tracker.gg/apex/profile/origin/p1mo/legends" target="_blank">
                    <app-icon name="game-controller"></app-icon>
                    <span class="name">Apex Legends</span>
                </a>
            </span>
        </div>
        <div class="image">
            {{{programmer_svg}}}
        </div>
    </div>

    <div class="skill-list">
        <div class="title">Skills</div>
        <div data-select-group class="items">
            {{#each skill_list}}
                <a data-selectable href="#" hx-get="/skill/{{this.uiid}}" class="item" hx-target="#skill_content">
                    {{{this.icon}}}
                    <span class="name">{{this.name}}</span>
                </a>
            {{/each}}
        </div>
        <div class="console" id="skill_content"></div>
    </div>

    <div class="langs">
        <span class="title">I Speak</span>
        <span class="image">{{{langs_svg}}}</span>
    </div>

    <div class="contact">
        <span class="title">Questions or Something in Mind?</span>
        <span class="text">Let’s Talk <app-icon name="at"></app-icon> <a href="mailto:contact@p1mo.dev">contact@p1mo.dev</a></span>
    </div>

</div>