<h1 class="history-h1">My History</h1>
<div class="history-container">
    {{#each history}}
        {{#if this.space}}
        <div class="space">
            <div class="line"></div>
            {{#if this.icon}}
                {{{this.icon}}}
            {{/if}}
            <span class="title">{{{this.title}}}</span>
            <span class="time">{{this.time}}</span>
            <span class="desc">{{{this.desc}}}</span>
            <div class="line"></div>
        </div>
        {{else}}
        <div class="card">
            {{#if this.icon}}
                {{{this.icon}}}
            {{/if}}
            <span class="title">{{{this.title}}}</span>
            <span class="time">{{this.time}}</span>
            <span class="desc">{{{this.desc}}}</span>
        </div>
        {{/if}}
    {{/each}}
</div>